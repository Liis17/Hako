POSTGRES_PASSWORD=replace_me_postgres_password
HAKO_AUTH_DB_PASSWORD=replace_me_auth_database_password
HAKO_PACK_DB_PASSWORD=replace_me_pack_database_password

HAKO_AUTH_PUBLIC_ADDR=0.0.0.0:8081
HAKO_AUTH_INTERNAL_ADDR=0.0.0.0:8091
HAKO_AUTH_DATABASE_URL=postgres://hako_auth:replace_me_auth_database_password@postgres:5432/hako_auth
HAKO_TELEGRAM_BOT_TOKEN=replace_me_telegram_bot_token
HAKO_AUTH_SERVICE_SECRET=replace_me_auth_service_secret
HAKO_AUTH_TRUSTED_PROXIES=
RUST_LOG=info

HAKO_PACK_ADDR=0.0.0.0:8082
HAKO_PACK_DATABASE_URL=postgres://hako_pack:replace_me_pack_database_password@postgres:5432/hako_pack
HAKO_PACK_AUTH_INTERNAL_URL=http://auth:8091
# Must match HAKO_AUTH_SERVICE_SECRET for internal Auth token checks.
HAKO_PACK_SERVICE_SECRET=replace_me_auth_service_secret

# Optional S3-compatible storage. Leave all required S3 values unset to run Pack without storage.
# HAKO_S3_ENDPOINT=https://s3.example.invalid
# HAKO_S3_BUCKET=hako-packs
# HAKO_S3_REGION=us-east-1
# HAKO_S3_ACCESS_KEY_ID=replace_me_s3_access_key_id
# HAKO_S3_SECRET_ACCESS_KEY=replace_me_s3_secret_access_key
# HAKO_S3_SESSION_TOKEN=
# HAKO_S3_PATH_STYLE=true

# Pack upload and archive validation limits (defaults shown).
# HAKO_PACK_MAX_ARCHIVE_BYTES=1073741824
# HAKO_PACK_MAX_UNCOMPRESSED_BYTES=4294967296
# HAKO_PACK_MAX_ENTRIES=10000
# HAKO_PACK_MAX_MANIFEST_BYTES=1048576
# HAKO_PACK_VALIDATION_CONCURRENCY=2
# HAKO_PACK_VALIDATION_TIMEOUT_SECS=900
# Delayed cleanup in seconds; greater than the one-hour download limit and at most one day.
# HAKO_PACK_CLEANUP_DELAY=86400
