<Page
    x:Class="Hako.ModpackCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,32,32,20" RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="2*,*,*" ColumnSpacing="12">
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="MinecraftBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Filter_SelectionChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24">
            <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="10">
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="LoadingText" />
                </StackPanel>
                <StackPanel x:Name="ErrorPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button x:Name="RetryButton" Click="RetryButton_Click" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectList" Spacing="8" Padding="0,0,8,8" />
                </ScrollViewer>
                <Button x:Name="MoreButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="MoreButton_Click" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,8,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Width="64" Height="64" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image x:Name="ProjectIcon" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="SelectedTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="ProjectLink" Padding="0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SelectedDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" />
                    <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" DisplayMemberPath="Display" SelectionChanged="VersionBox_SelectionChanged" />
                    <Button x:Name="RetryVersionsButton" HorizontalAlignment="Left" Click="RetryVersionsButton_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="VersionDetails" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UnsupportedText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    <Button x:Name="ChooseButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Click="ChooseButton_Click" IsEnabled="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
