<Page
    x:Class="Hako.HakoLoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowDefinitions="Auto,*">
        <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" Click="BackButton_Click" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" Spacing="20" VerticalAlignment="Center" Margin="0,24,0,0">
                <TextBlock x:Name="LoginTitle" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="LoginInstructions" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <StackPanel x:Name="FormPanel" Spacing="12">
                    <TextBox x:Name="UsernameBox" MaxLength="33" PlaceholderText="" />
                    <TextBlock x:Name="FormErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="LoginButton" Style="{ThemeResource AccentButtonStyle}" Click="LoginButton_Click" />
                        <Button x:Name="RegisterButton" Click="RegisterButton_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RequestingPanel" Visibility="Collapsed" Spacing="12">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock x:Name="RequestingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="PendingPanel" Visibility="Collapsed" Spacing="14">
                    <TextBlock x:Name="PendingTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PendingCountdown" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BotLinkText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <StackPanel x:Name="BotLinkButtons" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <Button x:Name="OpenBotButton" Style="{ThemeResource AccentButtonStyle}" Click="OpenBotButton_Click" />
                        <Button x:Name="CopyBotButton" Click="CopyBotButton_Click" />
                    </StackPanel>
                    <InfoBar x:Name="PendingNotice" IsOpen="False" Severity="Warning" />
                </StackPanel>

                <StackPanel x:Name="ExchangingPanel" Visibility="Collapsed" Spacing="12">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock x:Name="ExchangingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="FailedPanel" Visibility="Collapsed" Spacing="16">
                    <TextBlock x:Name="FailureText" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <InfoBar x:Name="FreshLoginNotice" IsOpen="False" Severity="Warning" />
                    <StackPanel x:Name="FreshLoginPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="FreshUsernameBox" MaxLength="33" PlaceholderText="" />
                        <TextBlock x:Name="FreshLoginErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RetryButton" Style="{ThemeResource AccentButtonStyle}" Click="RetryButton_Click" />
                        <Button x:Name="FreshLoginButton" Click="FreshLoginButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
