<Page
    x:Class="Hako.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowDefinitions="Auto,*,Auto">
        <ComboBox x:Name="LanguageBox" Grid.Row="0" HorizontalAlignment="Right" SelectionChanged="LanguageBox_SelectionChanged">
            <ComboBoxItem Content="Русский" />
            <ComboBoxItem Content="English" />
        </ComboBox>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" Spacing="20" VerticalAlignment="Center">
                <TextBlock x:Name="WelcomeTitle" FontSize="44" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="WelcomeSubtitle" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <InfoBar x:Name="StartupInfoBar" IsOpen="False" Severity="Warning" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                    <Button x:Name="StartButton" Style="{ThemeResource AccentButtonStyle}" Click="StartButton_Click" />
                    <Button x:Name="GuestButton" Click="GuestButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="Disclaimer" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </Grid>
</Page>
