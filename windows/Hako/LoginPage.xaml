<Page
    x:Class="Hako.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowDefinitions="Auto,*">
        <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" Click="BackButton_Click" />
        <StackPanel Grid.Row="1" MaxWidth="680" Spacing="20" VerticalAlignment="Center">
            <TextBlock x:Name="LoginTitle" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressRing IsActive="True" Width="32" Height="32" />
            <TextBlock x:Name="LoginStatus" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
