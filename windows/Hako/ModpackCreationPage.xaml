<Page
    x:Class="Hako.ModpackCreationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hako">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid Padding="32,32,32,20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="24" Padding="0,0,16,16">
                <local:InstanceIconPicker x:Name="IconPicker" />
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="NameLabel" FontWeight="SemiBold" />
                        <TextBlock x:Name="NameCounter" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="NameBox" MaxLength="60" TextChanged="NameBox_TextChanged" />
                    <TextBlock x:Name="NameHint" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VersionTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LoaderText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="CheckingPanel" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="CheckingText" />
                </StackPanel>
                <TextBlock x:Name="PreparedText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <StackPanel x:Name="ErrorPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button x:Name="RetryButton" Click="RetryButton_Click" />
                </StackPanel>
                <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False">
                    <local:InstanceParametersEditor x:Name="ParametersEditor" />
                </Expander>
                <TextBlock x:Name="SaveErrorText" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="CancelButton" Grid.Column="1" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click" IsEnabled="False" />
        </Grid>
    </Grid>
</Page>
