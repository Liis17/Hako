<Page
    x:Class="Hako.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hako">
    <Grid Padding="32" RowDefinitions="Auto,*">
        <TextBlock x:Name="SettingsTitle" FontSize="32" FontWeight="SemiBold" />
        <Grid Grid.Row="1" ColumnDefinitions="220,*" Margin="0,24,0,0">
            <ListView x:Name="SettingsSections" SelectionMode="Single" SelectionChanged="SettingsSections_SelectionChanged">
                <ListViewItem Tag="General">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock x:Name="GeneralSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="Profile">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Contact" />
                        <TextBlock x:Name="ProfileSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,0,0">
                <Grid>
                    <StackPanel x:Name="GeneralPanel" Spacing="20">
                        <TextBlock x:Name="GeneralTitle" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LanguageLabel" />
                            <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged">
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="ProfilePanel" Visibility="Collapsed" SizeChanged="ProfilePanel_SizeChanged">
                        <Grid x:Name="ProfileLayout" ColumnDefinitions="360,*" ColumnSpacing="24" RowDefinitions="Auto,*">
                            <TextBlock x:Name="ProfileTitle" Grid.ColumnSpan="2" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <StackPanel x:Name="ProfileCards" Grid.Row="1" Spacing="12">
                                <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            <FontIcon x:Name="AvatarPlaceholder" Glyph="&#xE77B;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="AccountAvatar" Width="64" Height="64" Visibility="Collapsed" ImageFailed="AccountAvatar_ImageFailed" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock x:Name="ProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="XboxBadge" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="ProfileEmail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                        <Border Width="64" Height="64" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <Image x:Name="MinecraftHead" Width="64" Height="64" Stretch="Fill" Visibility="Collapsed" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock x:Name="MinecraftStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="MinecraftBadge" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="MinecraftDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button x:Name="SignOutButton" HorizontalAlignment="Left" Click="SignOutButton_Click" />
                            </StackPanel>

                            <local:MinecraftSkinView x:Name="SkinView" Grid.Row="1" Grid.Column="1" MinHeight="400" />

                            <StackPanel x:Name="GuestProfilePanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Spacing="16">
                                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="16">
                                        <TextBlock x:Name="GuestProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="GuestProfileDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button x:Name="SignInButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SignInButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SignedOutProfilePanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Spacing="16">
                                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="16">
                                        <TextBlock x:Name="SignedOutProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="SignedOutProfileDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button x:Name="SignedOutSignInButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SignInButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
