<Page
    x:Class="Hako.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hako">
    <Page.Resources>
        <Style x:Key="LogoutConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Page.Resources>
    <Grid Padding="32" RowDefinitions="Auto,*" ColumnDefinitions="220,*">
        <TextBlock x:Name="SettingsTitle" Grid.ColumnSpan="2" FontSize="32" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="220,*" Margin="0,24,0,0">
            <ListView x:Name="SettingsSections" SelectionMode="Single" SelectionChanged="SettingsSections_SelectionChanged">
                <ListViewItem Tag="General">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock x:Name="GeneralSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="Game">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" />
                        <TextBlock x:Name="GameSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="Storage">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEDA2;" />
                        <TextBlock x:Name="StorageSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="Profile">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Contact" />
                        <TextBlock x:Name="ProfileSectionLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,0,0">
                <Grid>
                    <StackPanel x:Name="GeneralPanel" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock x:Name="GeneralTitle" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LanguageLabel" />
                            <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged">
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AppUpdatesTitle" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="AppVersionText" />
                                <CheckBox x:Name="AutomaticAppUpdatesBox" Click="AutomaticAppUpdatesBox_Click" />
                                <TextBlock x:Name="AppUpdateStatus" TextWrapping="Wrap" />
                                <ProgressBar x:Name="AppUpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <StackPanel Spacing="8" HorizontalAlignment="Left">
                                    <Button x:Name="CheckAppUpdateButton" Click="CheckAppUpdateButton_Click" />
                                    <Button x:Name="DownloadAppUpdateButton" Click="DownloadAppUpdateButton_Click" Visibility="Collapsed" />
                                    <Button x:Name="InstallAppUpdateButton" Click="InstallAppUpdateButton_Click" Visibility="Collapsed" />
                                    <Button x:Name="CancelAppUpdateButton" Click="CancelAppUpdateButton_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <HyperlinkButton x:Name="AppReleasesLink" NavigateUri="https://github.com/Liis17/Hako/releases" Padding="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="GamePanel" Spacing="20" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock x:Name="GameTitle" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="GameDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Java" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBox x:Name="JavaPathBox" FontFamily="Consolas" TextChanged="GameText_TextChanged" />
                                    <Button x:Name="ChooseJavaButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseJavaButton_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaPathCaption" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="GlobalJavaArgumentsBox" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="96" TextChanged="GameText_TextChanged" />
                                <local:JavaMemorySlider x:Name="GlobalMemorySlider" />
                                <TextBlock x:Name="GlobalMemoryCaption" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Minecraft" FontSize="18" FontWeight="SemiBold" />
                                <TextBox x:Name="GlobalMinecraftArgumentsBox" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="96" TextChanged="GameText_TextChanged" />
                            </StackPanel>
                        </Border>
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="WindowCardTitle" FontSize="18" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="GlobalFullscreenSwitch" Toggled="GlobalFullscreenSwitch_Toggled" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBox x:Name="GlobalWidthBox" TextChanged="GameText_TextChanged" />
                                        <TextBlock x:Name="GlobalWidthError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBox x:Name="GlobalHeightBox" TextChanged="GameText_TextChanged" />
                                        <TextBlock x:Name="GlobalHeightError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="WindowCaption" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GameSaveError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="StoragePanel" Spacing="16" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="DiskSpaceTitle" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel x:Name="DiskLoadingPanel" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="DiskLoadingRing" Width="20" Height="20" />
                                    <TextBlock x:Name="DiskLoadingText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="DiskErrorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                <StackPanel x:Name="DiskDataPanel" Spacing="14" Visibility="Collapsed">
                                    <TextBlock x:Name="DiskVolumeName" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Border Height="12" CornerRadius="6" Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                        <Grid x:Name="DiskSpaceSegments" Height="12" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="StorageUsedLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="DiskUsedValue" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:Name="StorageFreeLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="DiskFreeValue" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock x:Name="StorageTotalLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="DiskTotalValue" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DiskBuildsLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DiskBuildsShare" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="StorageUsageTitle" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="StorageOccupyLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="StorageTotalUsage" Grid.Column="1" FontWeight="SemiBold" />
                                </Grid>
                                <StackPanel x:Name="StorageUsageLoadingPanel" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="StorageUsageLoadingRing" Width="20" Height="20" />
                                    <TextBlock x:Name="StorageUsageLoadingText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="StorageSizeErrorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                <StackPanel x:Name="StorageUsageContent" Spacing="14" Visibility="Collapsed">
                                    <Border Height="12" CornerRadius="6" Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                        <Grid x:Name="StorageCategoryBar" Height="12" />
                                    </Border>
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#E0607E" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryWorlds" Grid.Column="1" />
                                            <TextBlock x:Name="StorageWorldsPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageWorldsSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#7C8DB5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryMinecraft" Grid.Column="1" />
                                            <TextBlock x:Name="StorageMinecraftPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageMinecraftSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#F2884B" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryScreenshots" Grid.Column="1" />
                                            <TextBlock x:Name="StorageScreenshotsPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageScreenshotsSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#E5B93C" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryJava" Grid.Column="1" />
                                            <TextBlock x:Name="StorageJavaPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageJavaSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#4FA37A" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryMods" Grid.Column="1" />
                                            <TextBlock x:Name="StorageModsPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageModsSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#3FA7B8" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryDatapacks" Grid.Column="1" />
                                            <TextBlock x:Name="StorageDatapacksPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageDatapacksSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#8E6BBF" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryResourcePacks" Grid.Column="1" />
                                            <TextBlock x:Name="StorageResourcePacksPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageResourcePacksSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#9A9A9A" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryBuildBackups" Grid.Column="1" />
                                            <TextBlock x:Name="StorageBuildBackupsPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageBuildBackupsSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="10,*,56,90" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" Fill="#6E6E6E" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StorageCategoryWorldBackups" Grid.Column="1" />
                                            <TextBlock x:Name="StorageWorldBackupsPercent" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" />
                                            <TextBlock x:Name="StorageWorldBackupsSize" Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="StorageBuildsFooter" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="ProfilePanel" Visibility="Collapsed" SizeChanged="ProfilePanel_SizeChanged">
                        <Grid x:Name="ProfileLayout" ColumnDefinitions="360,*" ColumnSpacing="24" RowDefinitions="Auto,*">
                            <TextBlock x:Name="ProfileTitle" Grid.ColumnSpan="2" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <StackPanel x:Name="ProfileCards" Grid.Row="1" Spacing="12">
                                <StackPanel x:Name="MicrosoftProfileCards" Spacing="12">
                                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                            <Grid Width="64" Height="64" VerticalAlignment="Center">
                                                <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <FontIcon x:Name="AvatarPlaceholder" Glyph="&#xE77B;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="AccountAvatar" Width="64" Height="64" Visibility="Collapsed" ImageFailed="AccountAvatar_ImageFailed" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock x:Name="ProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="XboxBadge" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="ProfileEmail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                <Button x:Name="SignOutButton" Margin="0,8,0,0" HorizontalAlignment="Left" Click="SignOutButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                            <Border Width="64" Height="64" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <Image x:Name="MinecraftHead" Width="64" Height="64" Stretch="Fill" Visibility="Collapsed" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock x:Name="MinecraftStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="MinecraftBadge" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="MinecraftDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="AccountPlaytimeCard" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="AccountPlaytimeTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="AccountPlaytimeValue" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AccountPlaytimeError" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="GuestProfilePanel" Visibility="Collapsed" Spacing="16">
                                    <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="16">
                                            <TextBlock x:Name="GuestProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="GuestProfileDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="GuestPlaytimeTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="GuestPlaytimeValue" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GuestPlaytimeTransfer" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="GuestPlaytimeError" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                            <Button x:Name="SignInButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SignInButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="SignedOutProfilePanel" Visibility="Collapsed" Spacing="16">
                                    <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="16">
                                            <TextBlock x:Name="SignedOutProfileStatus" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SignedOutProfileDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Button x:Name="SignedOutSignInButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SignInButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="HakoProviderPanel" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="HakoProviderTitle" FontSize="18" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="HakoProfileStatus" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HakoProfileDetails" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HakoProfileError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock x:Name="HakoProfileBadge" Grid.Column="1" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                        <StackPanel x:Name="HakoPlaytimePanel" Spacing="4" Visibility="Collapsed">
                                            <TextBlock x:Name="HakoPlaytimeTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="HakoPlaytimeValue" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HakoPlaytimePending" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="HakoPlaytimeError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button x:Name="HakoSignInButton" Style="{ThemeResource AccentButtonStyle}" Click="HakoSignInButton_Click" />
                                            <Button x:Name="HakoSignOutButton" Click="HakoSignOutButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="CharacterPanel" Grid.Row="1" Grid.Column="1" Spacing="16">
                                <local:MinecraftSkinView x:Name="SkinView" MinHeight="400" />
                                <Button x:Name="EditCharacterButton" Width="230" HorizontalAlignment="Center" Click="EditCharacter_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
        <local:MinecraftCharacterEditorView x:Name="CharacterEditor" Grid.Column="1" Grid.RowSpan="2" Margin="24,0,0,0" Visibility="Collapsed" BackRequested="CharacterEditor_BackRequested" />
    </Grid>
</Page>
