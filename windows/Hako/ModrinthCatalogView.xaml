<UserControl
    x:Class="Hako.ModrinthCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hako">
    <StackPanel x:Name="CatalogLayout" Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button x:Name="BackButton" Click="BackButton_Click" VerticalAlignment="Center" />
            <TextBlock x:Name="CatalogTitle" Grid.Column="1" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="CatalogContextText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox x:Name="SearchBox" PlaceholderText="" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="190" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Tag="Relevance" />
                <ComboBoxItem Tag="Downloads" />
                <ComboBoxItem Tag="Newest" />
                <ComboBoxItem Tag="Updated" />
            </ComboBox>
        </Grid>
        <StackPanel x:Name="CatalogStatusPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <ProgressRing x:Name="CatalogProgress" Width="18" Height="18" IsActive="False" />
            <TextBlock x:Name="CatalogStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="CatalogErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="CatalogActionFeedbackText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="CatalogInstalledErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="CatalogBlockedText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <Button x:Name="RetryButton" HorizontalAlignment="Left" Click="RetryButton_Click" Visibility="Collapsed" />
        <TextBlock x:Name="CatalogEmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <ItemsRepeater x:Name="ProjectsRepeater" Margin="0,0,0,8">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:ModrinthCatalogRow">
                    <Border Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
                            <Grid Width="48" Height="48">
                                <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{x:Bind PlaceholderVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind Icon}" Stretch="UniformToFill" Visibility="{x:Bind IconVisibility}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <HyperlinkButton Content="{x:Bind Title}" Tag="{x:Bind Project}" Click="ProjectLink_Click"
                                                 Padding="0" HorizontalAlignment="Left" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Description}" MaxLines="2" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ReleaseHint}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ReleaseHintVisibility}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="{x:Bind AddText}" Tag="{x:Bind Project}" Click="AddButton_Click"
                                        IsEnabled="{x:Bind AddEnabled}" ToolTipService.ToolTip="{x:Bind AddHint}" />
                                <Button Content="⋯" Tag="{x:Bind Project}" Click="ChannelMenuButton_Click"
                                        IsEnabled="{x:Bind MenuEnabled}" ToolTipService.ToolTip="{x:Bind ChannelMenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Button x:Name="LoadMoreButton" Click="LoadMoreButton_Click" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
