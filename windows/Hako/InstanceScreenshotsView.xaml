<UserControl
    x:Class="Hako.InstanceScreenshotsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hako">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Padding="0,8,0,24" Spacing="14">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="ScreenshotsTitle" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScreenshotsCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScreenshotsSelectionCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshButton_Click" />
                <Button x:Name="OpenFolderButton" Grid.Column="2" Click="OpenFolderButton_Click" />
                <Button x:Name="DeleteButton" Grid.Column="3" Click="DeleteButton_Click" />
            </Grid>
            <TextBlock x:Name="ScreenshotsBlockReason" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="LoadingText" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="OperationPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="18" Height="18" IsActive="True" />
                <TextBlock x:Name="OperationText" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
            <GridView x:Name="ScreenshotItems" ItemsSource="{x:Bind _rows, Mode=OneWay}"
                      SelectionMode="Multiple" SelectionChanged="ScreenshotItems_SelectionChanged"
                      IsMultiSelectCheckBoxEnabled="True" CanDragItems="True" DragItemsStarting="ScreenshotItems_DragItemsStarting"
                      DragStarting="ScreenshotItems_DragStarting"
                      KeyDown="ScreenshotItems_KeyDown" IsItemClickEnabled="False" Margin="0,0,0,12">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="224" ItemHeight="176" MaximumRowsOrColumns="4" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ScreenshotRow">
                        <Border Width="210" Height="160" Padding="8" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Loaded="ScreenshotTile_Loaded" Unloaded="ScreenshotTile_Unloaded"
                                Tag="{x:Bind}">
                            <Grid RowDefinitions="*,Auto">
                                <Grid Background="Transparent" DoubleTapped="ScreenshotTile_DoubleTapped" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                           Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,7,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CreatedText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⋯" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind ActionsText, Mode=OneWay}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind OpenText, Mode=OneWay}" Tag="{x:Bind}" Click="OpenScreenshot_Click" />
                                                <MenuFlyoutItem Text="{x:Bind OpenFolderText, Mode=OneWay}" Tag="{x:Bind}" Click="OpenScreenshotFolder_Click" />
                                                <MenuFlyoutItem Text="{x:Bind DeleteText, Mode=OneWay}" Tag="{x:Bind}" Click="DeleteScreenshot_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
