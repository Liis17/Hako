<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.10.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.10.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hako.Core\Hako.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Hako\MinecraftSkinImageDecoder.cs" Link="MinecraftSkinImageDecoder.cs" />
    <Compile Include="..\Hako\MinecraftSkinHeadComposer.cs" Link="MinecraftSkinHeadComposer.cs" />
    <Compile Include="..\Hako\MinecraftSkinHeadBitmapConverter.cs" Link="MinecraftSkinHeadBitmapConverter.cs" />
    <Compile Include="..\Hako\Graphics\MinecraftSkinGeometry.cs" Link="MinecraftSkinGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Hako\Strings\**\Resources.resw" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Hako\Assets\Steve.png" Link="Fixtures\WindowsSteve.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\macos\Hako\Hako\Resources\Steve.png" Link="Fixtures\MacSteve.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\macos\Hako\HakoTests\Fixtures\1.6.4.json" Link="Fixtures\Mojang\1.6.4.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\macos\Hako\HakoTests\Fixtures\1.19.json" Link="Fixtures\Mojang\1.19.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\macos\Hako\HakoTests\Fixtures\22w18a.json" Link="Fixtures\Mojang\22w18a.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\macos\Hako\HakoTests\Fixtures\java-runtimes.json" Link="Fixtures\Mojang\java-runtimes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
